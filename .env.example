# Optional: Google sign-in. Leave all three empty and Docutile runs without sign-in, exactly as before.
# Generate AUTH_SECRET with:  openssl rand -base64 32
AUTH_SECRET=
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI:  https://YOUR-SITE/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional allow-lists, comma-separated. With neither set, any Google-verified account may sign in.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
